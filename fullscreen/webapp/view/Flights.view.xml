<mvc:View
    controllerName="student00i.com.sap.training.ux402.fullscreen.fullscreen.controller.Flights"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
>
    <Page
        id="_idPageFlights"
        title="{Carrname}"
        navButtonPress="onNavBack"
        showNavButton="true"
    >
        <content>
            <l:VerticalLayout id="_idVerticalLayoutFlights">
                <ObjectHeader
                    id="_idObjectHeader"
                    title="{Carrname}"
                    number=""
                    numberUnit="{Currcode}"
                    titleHref="{Url}"
                >
                    <attributes>
                        <ObjectAttribute
                            id="_idObjectAttributeCarrid"
                            text="{Carrid}"
                        />
                        <ObjectAttribute
                            id="_idObjectAttributeUrl"
                            text="{Url}"
                        />
                    </attributes>
                </ObjectHeader>
            </l:VerticalLayout>
            <Table
                id="_idTableFlights"
                items="{path: 'to_Flights', sorter: {path: 'Carrid'}}"
                mode="SingleSelectMaster"
                growing="true"
                growingThreshold="10"
            >
                <headerToolbar>
                    <Toolbar id="_idToolbarFlights">
                        <Title
                            id="_idTitleFlights"
                            text="Voos"
                            level="H2"
                        />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column id="_idColumnCarrierName">
                        <Text
                            id="_idTextCarrierName"
                            text="{i18n>carriername}"
                        />
                    </Column>
                    <Column id="_idColumnFlightDate">
                        <Text
                            id="_idTextFlightDate"
                            text="{i18n>flightdate}"
                        />
                    </Column>
                    <Column id="_idColumnSeatMax">
                        <Text
                            id="_idTextSeatMax"
                            text="{i18n>seatmax}"
                        />
                    </Column>
                    <Column id="_idColumnSeatOcc">
                        <Text
                            id="_idTextSeatOcc"
                            text="{i18n>seatocc}"
                        />
                    </Column>
                </columns>
                <items>
                <ColumnListItem id="_idColumnListItemFlights">
                    <cells>
                        <ObjectIdentifier id="_idObjectIdentifier" title="{Carrid}" text="{Carrid}"/>
                        <Text id="_idCellsTextFlighDate" text="{path: 'Fldate', type: 'sap.ui.model.type.Date'}"/>
                        <Text id="_idCellsTextSeatsMax" text="{Seatsmax}"/>
                        <Text id="_idCellsTextSeatsOcc" text="{Seatsocc}"/>
                    </cells>
                </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
